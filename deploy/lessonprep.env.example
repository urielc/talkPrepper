# Copy to /etc/lessonprep.env, edit, then: chmod 600 /etc/lessonprep.env
#
# Referenced by deploy/lessonprep.service via EnvironmentFile=.

# Where the database, scriptures/talks JSON and embeddings live — outside the
# git clone, so the app's own code directory never needs to be writable.
LP_DATA_DIR=/var/lib/lessonprep

# The public origin, no path. Required whenever LP_TRUST_PROXY or
# LP_COOKIE_SECURE is set (the app refuses to start otherwise) — used to build
# invite/reset links and, since it's https://, implies Secure session cookies.
LP_BASE_URL=https://CHANGE.ME

# nginx sits in front (see deploy/nginx.conf) and sets X-Real-IP itself.
LP_TRUST_PROXY=1

# Encrypts the AI/email secrets stored in the database. Generate one with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key makes the stored secrets unrecoverable (re-enter them in
# Settings after rotating it). Leave unset and the app will instead generate
# and use LP_DATA_DIR/secret.key on first run.
LP_SECRET_KEY=
